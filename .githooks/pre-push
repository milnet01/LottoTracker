#!/usr/bin/env bash
#
# pre-push - run the gate before anything leaves this machine.
#
# Enable once per clone (hooks are not themselves tracked by git):
#
#     git config core.hooksPath .githooks
#
# local-CI.sh decides for itself whether the push needs gating: a
# documentation-only push (every changed file .md) runs the privacy check and
# skips the rest. To push past a red gate deliberately, `git push --no-verify`.
#
# git hands us one line per ref actually being pushed, on stdin:
#
#     <local-ref> <local-sha> <remote-ref> <remote-sha>
#
# We turn those into diff ranges and pass them on. Without this the gate fell
# back to the CURRENT BRANCH's configured upstream, which is a different
# question with a different answer: `git push origin featureX` from a docs
# branch skipped the gate and pushed featureX's Python ungated, and a push to
# a second remote gated against the wrong range entirely - which is exactly
# when "run the gate before anything leaves this machine" matters most.

# git's stdin can be read only once, and two readers need it: the secret scan
# and the range builder below. So read it into a variable and feed both.
refs=$(cat)

# The secret scan over the pushed commits (local-gate.md § 2.1). It runs on
# EVERY push, the documentation-only ones included, because local-CI.sh's
# docs skip must never be a route past it. The machine-wide hook owns the
# scan; --secrets-only runs it and no gate. On a machine without that hook,
# say so: a scan that did not run must not look like one that passed.
SHARED_HOOK="${ANTS_GLOBAL_HOOKS:-$HOME/.claude/githooks}/pre-push"
if [ -x "$SHARED_HOOK" ]; then
    printf '%s\n' "$refs" | "$SHARED_HOOK" --secrets-only "$1" || exit 1
else
    echo "pre-push: NO SECRET SCAN - $SHARED_HOOK is absent" >&2
fi

ZERO=0000000000000000000000000000000000000000
ranges=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    # A deletion pushes nothing to gate.
    [ "$local_sha" = "$ZERO" ] && continue
    if [ "$remote_sha" = "$ZERO" ]; then
        ranges="$ranges $local_sha"          # new ref: everything it carries
    else
        ranges="$ranges $remote_sha..$local_sha"
    fi
done <<EOF_REFS
$refs
EOF_REFS

export GATE_RANGES="${ranges# }"
exec ./local-CI.sh
